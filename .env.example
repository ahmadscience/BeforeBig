# Offline demo defaults. Leave credentials blank to browse fictional sample records.
# See docs/SETUP.md before enabling persistence or external providers.
# Turso / libSQL. Keep both values server-only.
DATABASE_URL=""
DATABASE_AUTH_TOKEN=""

# Public application configuration
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3247"
NEXT_PUBLIC_BRAND_NAME="BeforeBig"
TRAFFIC_FEATURE_ENABLED="false"
PAYMENTS_FEATURE_ENABLED="false"
EMAIL_FEATURE_ENABLED="false"
EMAIL_PROVIDER="mailgun"
EMAIL_API_KEY=""
EMAIL_FROM=""
# Mailgun sending domain and region. Use https://api.eu.mailgun.net for an EU-region domain.
MAILGUN_DOMAIN=""
MAILGUN_API_BASE_URL="https://api.mailgun.net"
# Mailgun, Resend, and Postmark are supported.

# Local-only login helper. It displays the one-use link instead of emailing it and is forcibly disabled in production.
AUTH_DEV_MAGIC_LINK_ENABLED="false"

# Authenticated writes are protected by durable database rate limits.
SUBMISSION_PERSISTENCE_ENABLED="false"
RATE_LIMIT_HASH_SALT=""
# HMAC key for one-IP-per-product reaction locks. Raw IP addresses are never stored.
VOTE_IP_HASH_SALT=""
VERIFICATION_SECRET=""

# Comma-separated users promoted to admin when they complete a valid magic-link login.
ADMIN_EMAILS=""

# Anonymous internal analytics. Generate a long random value and keep it server-only.
ANALYTICS_HASH_SALT=""

# Google reCAPTCHA v2 checkbox for anonymous write forms such as sign-in. Registered users do not receive a CAPTCHA.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_ALLOWED_HOSTNAMES="127.0.0.1,localhost,your-domain.com"

# Optional GA4 web stream and read-only reporting. Leave blank to use internal counters only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GA_PROPERTY_ID=""
GA_CLIENT_EMAIL=""
GA_PRIVATE_KEY=""
